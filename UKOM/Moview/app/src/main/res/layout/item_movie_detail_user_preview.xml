<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="50dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="6dp"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <FrameLayout
        android:id="@+id/layout_avatar_container"
        android:layout_width="46dp"
        android:layout_height="46dp">

        <androidx.cardview.widget.CardView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Avatar"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_default_profile" />
        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/iv_badge_action"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="end|top"
            android:src="@drawable/ic_review"
            android:contentDescription="Has review"
            android:background="@drawable/circle_background_dark"
            android:padding="3dp"
            app:tint="@color/text_secondary" />
    </FrameLayout>

    <com.komputerkit.moview.ui.common.StarRatingView
        android:id="@+id/star_rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:visibility="gone"
        android:contentDescription="Star rating"
        tools:visibility="visible" />

</LinearLayout>
