<?xml version="1.0" encoding="utf-8"?>
<!-- One Top-4 slot. Width fills its grid cell (GridLayoutManager span 4).
     Height is 0dp+ratio in a normal parent, but RecyclerView measures children
     with an unspecified vertical spec, where 0dp+ratio collapses to 0 — so the
     exact height is applied at runtime from the measured width (see adapter/
     fragment); 120dp here is only the pre-measure fallback. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="120dp">

    <!-- Filled Slot (Movie Poster) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_poster"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Favorite Movie Poster"
            android:scaleType="centerCrop"
            tools:src="@android:color/holo_blue_dark" />

        <!-- Rank badge (Top 1..4) — updates immediately while reordering -->
        <TextView
            android:id="@+id/tv_rank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="4dp"
            android:background="#B3000000"
            android:minWidth="20dp"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="1" />

        <!-- Remove Icon -->
        <ImageView
            android:id="@+id/btn_remove"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:alpha="0.8"
            android:background="@android:color/black"
            android:contentDescription="Remove"
            android:padding="4dp"
            android:src="@drawable/ic_close"
            app:tint="@color/white" />
    </androidx.cardview.widget.CardView>

    <!-- Empty Slot (Add Button) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_add"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="visible"
        app:cardBackgroundColor="@color/dark_card"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/text_secondary"
        app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Add"
                android:src="@drawable/ic_add"
                app:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="ADD"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
