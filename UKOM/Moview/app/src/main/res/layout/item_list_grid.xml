<?xml version="1.0" encoding="utf-8"?>
<!--
  List poster cell: reuses the app's standard film grid item (item_film_grid)
  and only adds the optional rank badge on top of it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- No width/height override: the shared cell keeps its own 4dp margin,
         radius and 2:3 poster ratio. -->
    <include
        android:id="@+id/poster_card"
        layout="@layout/item_film_grid" />

    <TextView
        android:id="@+id/tv_rank"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_rank_badge"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="9sp"
        android:textStyle="bold"
        android:translationY="-14dp"
        android:visibility="gone"
        tools:text="1"
        tools:visibility="visible" />

</FrameLayout>
