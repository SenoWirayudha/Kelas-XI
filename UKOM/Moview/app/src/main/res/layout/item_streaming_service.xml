<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="6dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <!-- Logo Container with Badge -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1A1F2E">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_service_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="Streaming Service"
                app:shapeAppearanceOverlay="@style/RoundedCorner8dp"
                tools:src="@tools:sample/avatars" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Country flag (top-right corner of the service icon) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_country_flag"
            android:layout_width="18dp"
            android:layout_height="12dp"
            android:layout_gravity="top|end"
            android:elevation="2dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="Available country"
            app:shapeAppearanceOverlay="@style/RoundedCorner3dp" />

    </FrameLayout>

    <!-- Service Name -->
    <TextView
        android:id="@+id/tv_service_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/white"
        android:textSize="9sp"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="Netflix" />

    <!-- Availability type + status below the service name -->
    <TextView
        android:id="@+id/tv_type_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="@color/text_secondary"
        android:textSize="7sp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        tools:text="STREAM · AVAILABLE"
        tools:visibility="visible" />

    <!-- Release Date (for upcoming) -->
    <TextView
        android:id="@+id/tv_release_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="@color/text_secondary"
        android:textSize="8sp"
        android:gravity="center"
        android:visibility="gone"
        tools:text="Jan 15"
        tools:visibility="visible" />

</LinearLayout>
