<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/dark_background"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Profile"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Tab Switcher: Profil / Setting (fixed header) -->
    <LinearLayout
        android:id="@+id/layout_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:background="@color/dark_background"
        android:elevation="4dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tab_profil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tv_tab_profil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_family_inter"
                android:letterSpacing="0"
                android:text="Profil"
                android:textColor="@color/accent_blue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/tab_profil_indicator"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:background="@color/accent_blue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_setting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tv_tab_setting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_family_inter"
                android:letterSpacing="0"
                android:text="Setting"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/tab_setting_indicator"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:background="@color/accent_blue"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="100dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/edit_scroll_padding_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header with Avatar - Full Width Backdrop -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <!-- Backdrop + bottom fade. Fixed-height inner frame so the
                     gradient anchors to the backdrop's own bottom (the outer
                     FrameLayout wraps the taller photo container, which pushed
                     the gradient below the image and left a hard edge). -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/edit_backdrop_height">

                    <ImageView
                        android:id="@+id/iv_backdrop"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Backdrop"
                        tools:src="@android:color/darker_gray" />

                    <!-- Gradient Fade at Bottom (~55% of backdrop height) -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/edit_backdrop_fade_height"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_gradient_bottom" />
                </FrameLayout>

                <!-- Profile Photo Container - positioned absolutely to avoid clipping -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/edit_photo_container_top"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/edit_avatar_size"
                        android:layout_height="@dimen/edit_avatar_size"
                        app:cardCornerRadius="@dimen/edit_avatar_radius"
                        app:cardElevation="8dp">

                        <ImageView
                            android:id="@+id/iv_profile"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="Profile"
                            tools:src="@android:color/holo_orange_light" />

                        <!-- Camera Icon -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="@dimen/edit_camera_badge_size"
                            android:layout_height="@dimen/edit_camera_badge_size"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="4dp"
                            app:cardBackgroundColor="@color/accent_blue"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="4dp">

                            <ImageView
                                android:layout_width="@dimen/edit_camera_icon_size"
                                android:layout_height="@dimen/edit_camera_icon_size"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_camera"
                                android:contentDescription="Change Photo"
                                app:tint="@color/white" />
                        </androidx.cardview.widget.CardView>
                    </androidx.cardview.widget.CardView>

                    <!-- Set to default text -->
                    <TextView
                        android:id="@+id/tvSetDefault"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/auth_gap"
                        android:text="Set to default"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </FrameLayout>

            <!-- Content Section with Padding -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/auth_side_margin"
                android:paddingEnd="@dimen/auth_side_margin">

            <!-- Username -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Username"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/edit_label_text"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_gap"
                app:cardBackgroundColor="@color/dark_card"
                app:cardCornerRadius="@dimen/corner_control"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/edit_field_padding"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/edit_field_text" />

                    <EditText
                        android:id="@+id/et_username"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:hint="moviebuff_99"
                        android:inputType="text"
                        android:maxLength="20"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="@dimen/edit_field_text" />

                    <TextView
                        android:id="@+id/tv_username_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/auth_gap"
                        android:text="0/20"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bio -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/edit_section_gap"
                android:text="Bio"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/edit_label_text"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_gap"
                app:cardBackgroundColor="@color/dark_card"
                app:cardCornerRadius="@dimen/corner_control"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <EditText
                    android:id="@+id/et_bio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="top"
                    android:hint="Cinema lover. Sci-fi enthusiast. Always waiting for the next Christopher Nolan masterpiece."
                    android:inputType="textMultiLine"
                    android:minHeight="@dimen/edit_bio_min_height"
                    android:padding="@dimen/edit_field_padding"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/edit_field_text" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Location -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/edit_section_gap"
                android:text="Location"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/edit_label_text"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_gap"
                app:cardBackgroundColor="@color/dark_card"
                app:cardCornerRadius="@dimen/corner_control"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <EditText
                    android:id="@+id/et_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="New York, USA"
                    android:inputType="text"
                    android:padding="@dimen/edit_field_padding"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/edit_field_text" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Top 4 Favorites -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/edit_section_gap"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Top 4 Favorites"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />


            </LinearLayout>

            <!-- Favorites Grid — a single non-scrollable row of 4 equal slots
                 (GridLayoutManager span 4, set in code). -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_favorites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="4"
                tools:listitem="@layout/item_favorite_slot" />

            <!-- Backdrop Toggle -->
            <LinearLayout
                android:id="@+id/layout_backdrop_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_backdrop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />

                <TextView
                    android:id="@+id/tv_backdrop_label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Aktifkan backdrop, gunakan backdrop dari film favorit pertama"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Settings Tab Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="100dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/auth_side_margin"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/auth_side_margin">

            <!-- Ganti Password (expandable in place) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_change_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/dark_card"
                app:cardCornerRadius="@dimen/corner_control"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Header row: tap to expand/collapse -->
                    <LinearLayout
                        android:id="@+id/layout_change_password_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/edit_field_padding">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Password"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="Ganti Password"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/iv_change_password_arrow"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Expand"
                            android:src="@drawable/ic_arrow_right"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>

                    <!-- Expandable form -->
                    <LinearLayout
                        android:id="@+id/layout_change_password_form"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/edit_field_padding"
                        android:paddingEnd="@dimen/edit_field_padding"
                        android:paddingBottom="@dimen/edit_field_padding"
                        android:visibility="gone">

                        <!-- Password Baru -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/auth_field_height"
                            app:cardBackgroundColor="@color/dark_background"
                            app:cardCornerRadius="@dimen/corner_control"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/auth_input_padding_start"
                                android:paddingTop="@dimen/auth_input_padding_v"
                                android:paddingEnd="@dimen/auth_input_padding_end"
                                android:paddingBottom="@dimen/auth_input_padding_v">

                                <EditText
                                    android:id="@+id/et_change_new_password"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:background="@android:color/transparent"
                                    android:fontFamily="@font/font_family_inter"
                                    android:hint="Password Baru"
                                    android:inputType="textPassword"
                                    android:maxLines="1"
                                    android:textColor="@color/text_primary"
                                    android:textColorHint="@color/text_secondary"
                                    android:textSize="@dimen/auth_field_text" />

                                <ImageButton
                                    android:id="@+id/btn_toggle_new_password"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/toggle_password_visibility"
                                    android:src="@drawable/ic_visibility_off"
                                    app:tint="@color/text_secondary" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Konfirmasi Password -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/auth_gap_small"
                            android:minHeight="@dimen/auth_field_height"
                            app:cardBackgroundColor="@color/dark_background"
                            app:cardCornerRadius="@dimen/corner_control"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/auth_input_padding_start"
                                android:paddingTop="@dimen/auth_input_padding_v"
                                android:paddingEnd="@dimen/auth_input_padding_end"
                                android:paddingBottom="@dimen/auth_input_padding_v">

                                <EditText
                                    android:id="@+id/et_change_confirm_password"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:background="@android:color/transparent"
                                    android:fontFamily="@font/font_family_inter"
                                    android:hint="Konfirmasi Password"
                                    android:inputType="textPassword"
                                    android:maxLines="1"
                                    android:textColor="@color/text_primary"
                                    android:textColorHint="@color/text_secondary"
                                    android:textSize="@dimen/auth_field_text" />

                                <ImageButton
                                    android:id="@+id/btn_toggle_confirm_password"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/toggle_password_visibility"
                                    android:src="@drawable/ic_visibility_off"
                                    app:tint="@color/text_secondary" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Kode OTP -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/auth_gap_small"
                            android:minHeight="@dimen/auth_field_height"
                            app:cardBackgroundColor="@color/dark_background"
                            app:cardCornerRadius="@dimen/corner_control"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <EditText
                                android:id="@+id/et_change_otp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:enabled="false"
                                android:fontFamily="@font/font_family_inter"
                                android:hint="Kode OTP"
                                android:inputType="number"
                                android:maxLength="6"
                                android:maxLines="1"
                                android:paddingStart="@dimen/auth_input_padding_start"
                                android:paddingTop="@dimen/auth_input_padding_v"
                                android:paddingEnd="@dimen/auth_input_padding_end"
                                android:paddingBottom="@dimen/auth_input_padding_v"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_secondary"
                                android:textSize="@dimen/auth_field_text" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Kirim OTP -->
                        <Button
                            android:id="@+id/btn_send_change_otp"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="@dimen/auth_gap_small"
                            android:backgroundTint="@color/dark_surface"
                            android:fontFamily="@font/font_family_inter"
                            android:letterSpacing="0"
                            android:text="Kirim OTP"
                            android:textAllCaps="false"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="@dimen/corner_control" />

                        <!-- Ganti Password -->
                        <Button
                            android:id="@+id/btn_change_password"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/edit_button_height"
                            android:layout_marginTop="@dimen/auth_gap_small"
                            android:backgroundTint="@color/accent_blue"
                            android:enabled="false"
                            android:fontFamily="@font/font_family_inter"
                            android:letterSpacing="0"
                            android:text="Ganti Password"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="@dimen/edit_button_text"
                            android:textStyle="bold"
                            app:cornerRadius="@dimen/corner_control" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Log Out -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_logout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_gap_small"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/dark_card"
                app:cardCornerRadius="@dimen/corner_control"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/edit_field_padding">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Log Out"
                        android:src="@drawable/ic_logout"
                        app:tint="#FF5252" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Log Out"
                        android:textColor="#FF5252"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hapus Akun -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_delete_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_gap_small"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/dark_card"
                app:cardCornerRadius="@dimen/corner_control"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/edit_field_padding">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Delete Account"
                        android:src="@drawable/ic_close"
                        app:tint="#FF5252" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Hapus Akun"
                        android:textColor="#FF5252"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tentang Aplikasi -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_gap_small"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/dark_card"
                app:cardCornerRadius="@dimen/corner_control"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/edit_field_padding">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="About"
                        android:src="@drawable/ic_info"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Tentang Aplikasi"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar (Profil tab only) -->
    <LinearLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/dark_background"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="@dimen/edit_bottom_bar_padding">

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_button_height"
            android:backgroundTint="@color/accent_blue"
            android:fontFamily="@font/font_family_inter"
            android:letterSpacing="0"
            android:text="Save Changes"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/edit_button_text"
            android:textStyle="bold"
            app:cornerRadius="@dimen/corner_control" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
