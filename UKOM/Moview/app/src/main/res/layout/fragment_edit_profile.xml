<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/dark_background"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Profile"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:paddingBottom="@dimen/edit_scroll_padding_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header with Avatar - Full Width Backdrop -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <!-- Backdrop Background -->
                <ImageView
                    android:id="@+id/iv_backdrop"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/edit_backdrop_height"
                    android:scaleType="centerCrop"
                    android:contentDescription="Backdrop"
                    tools:src="@android:color/darker_gray" />

                <!-- Gradient Fade at Bottom (30-40% of backdrop height) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/edit_backdrop_fade_height"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_gradient_bottom" />

                <!-- Profile Photo Container - positioned absolutely to avoid clipping -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/edit_photo_container_top"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/edit_avatar_size"
                        android:layout_height="@dimen/edit_avatar_size"
                        app:cardCornerRadius="@dimen/edit_avatar_radius"
                        app:cardElevation="8dp">

                        <ImageView
                            android:id="@+id/iv_profile"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="Profile"
                            tools:src="@android:color/holo_orange_light" />

                        <!-- Camera Icon -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="@dimen/edit_camera_badge_size"
                            android:layout_height="@dimen/edit_camera_badge_size"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="4dp"
                            app:cardBackgroundColor="@color/accent_blue"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="4dp">

                            <ImageView
                                android:layout_width="@dimen/edit_camera_icon_size"
                                android:layout_height="@dimen/edit_camera_icon_size"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_camera"
                                android:contentDescription="Change Photo"
                                app:tint="@color/white" />
                        </androidx.cardview.widget.CardView>
                    </androidx.cardview.widget.CardView>

                    <!-- Set to default text -->
                    <TextView
                        android:id="@+id/tvSetDefault"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/auth_gap"
                        android:text="Set to default"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </FrameLayout>

            <!-- Content Section with Padding -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/auth_side_margin"
                android:paddingEnd="@dimen/auth_side_margin">

            <!-- Username -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Username"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/edit_label_text"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_gap"
                app:cardBackgroundColor="@color/dark_card"
                app:cardCornerRadius="@dimen/corner_control"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/edit_field_padding"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/edit_field_text" />

                    <EditText
                        android:id="@+id/et_username"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:hint="moviebuff_99"
                        android:inputType="text"
                        android:maxLength="20"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="@dimen/edit_field_text" />

                    <TextView
                        android:id="@+id/tv_username_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/auth_gap"
                        android:text="0/20"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bio -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/edit_section_gap"
                android:text="Bio"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/edit_label_text"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_gap"
                app:cardBackgroundColor="@color/dark_card"
                app:cardCornerRadius="@dimen/corner_control"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <EditText
                    android:id="@+id/et_bio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="top"
                    android:hint="Cinema lover. Sci-fi enthusiast. Always waiting for the next Christopher Nolan masterpiece."
                    android:inputType="textMultiLine"
                    android:minHeight="@dimen/edit_bio_min_height"
                    android:padding="@dimen/edit_field_padding"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/edit_field_text" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Location -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/edit_section_gap"
                android:text="Location"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/edit_label_text"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_gap"
                app:cardBackgroundColor="@color/dark_card"
                app:cardCornerRadius="@dimen/corner_control"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <EditText
                    android:id="@+id/et_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="New York, USA"
                    android:inputType="text"
                    android:padding="@dimen/edit_field_padding"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/edit_field_text" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Top 4 Favorites -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/edit_section_gap"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Top 4 Favorites"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />


            </LinearLayout>

            <!-- Favorites Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_favorites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="4"
                tools:listitem="@layout/item_favorite_slot" />

            <!-- Backdrop Toggle -->
            <LinearLayout
                android:id="@+id/layout_backdrop_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_backdrop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />

                <TextView
                    android:id="@+id/tv_backdrop_label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Aktifkan backdrop, gunakan backdrop dari film favorit pertama"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/dark_background"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="@dimen/edit_bottom_bar_padding">

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_button_height"
            android:backgroundTint="@color/accent_blue"
            android:fontFamily="@font/font_family_inter"
            android:letterSpacing="0"
            android:text="Save Changes"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/edit_button_text"
            android:textStyle="bold"
            app:cornerRadius="@dimen/corner_control" />

        <Button
            android:id="@+id/btn_logout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/auth_gap"
            android:background="@android:color/transparent"
            android:drawableStart="@drawable/ic_logout"
            android:drawablePadding="8dp"
            android:fontFamily="@font/font_family_inter"
            android:letterSpacing="0"
            android:text="Log Out"
            android:textAllCaps="false"
            android:textColor="#FF5252"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
