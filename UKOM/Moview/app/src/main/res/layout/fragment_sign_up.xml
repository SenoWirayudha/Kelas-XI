<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp">

        <!-- Backdrop bottom edge — percentage of the screen height, adjusted
             in SignUpFragment (30% normal; ~20% on short screens). -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_hero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.38" />

        <!-- Hero Image: same asset & treatment as Login, NO dark overlay, edge-to-edge -->
        <ImageView
            android:id="@+id/iv_hero"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/hero_image_description"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="@id/guideline_hero"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Subtle fade at the bottom edge of the hero only -->
        <View
            android:id="@+id/view_hero_fade"
            android:layout_width="0dp"
            android:layout_height="@dimen/auth_hero_fade_height"
            android:background="@drawable/gradient_backdrop_bottom"
            app:layout_constraintBottom_toBottomOf="@id/guideline_hero"
            app:layout_constraintEnd_toEndOf="@id/iv_hero"
            app:layout_constraintStart_toStartOf="@id/iv_hero" />

        <!-- Film credit inside the backdrop, bottom-left, clear of the logo -->
        <TextView
            android:id="@+id/tv_hero_credit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="@dimen/auth_caption_margin_bottom"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="9sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/guideline_hero"
            app:layout_constraintEnd_toEndOf="@id/iv_hero"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@id/iv_hero"
            tools:text="Scene from Parasite (2019)"
            tools:visibility="visible" />

        <!-- Logo: starts below the caption (>=12dp gap), never overlapping it -->
        <ImageView
            android:id="@+id/card_icon"
            android:layout_width="@dimen/auth_logo_size"
            android:layout_height="@dimen/auth_logo_size"
            android:layout_marginStart="@dimen/auth_side_margin"
            android:layout_marginEnd="@dimen/auth_side_margin"
            android:layout_marginTop="@dimen/auth_logo_margin_top"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_moview"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/guideline_hero" />

        <!-- Text logo -->
        <ImageView
            android:id="@+id/iv_app_name"
            android:layout_width="@dimen/auth_text_logo_width"
            android:layout_height="@dimen/auth_text_logo_height"
            android:layout_marginStart="@dimen/auth_side_margin"
            android:layout_marginEnd="@dimen/auth_side_margin"
            android:layout_marginTop="@dimen/auth_gap"
            android:contentDescription="@string/app_name"
            android:src="@drawable/text_logo_moview"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_icon" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/tv_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_side_margin"
            android:layout_marginEnd="@dimen/auth_side_margin"
            android:layout_marginTop="@dimen/auth_gap_small"
            android:text="Buat akun dan mulai menonton"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_app_name" />

        <!-- Username Input -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_username"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/auth_field_height"
            android:layout_marginStart="@dimen/auth_side_margin"
            android:layout_marginEnd="@dimen/auth_side_margin"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/dark_surface"
            app:cardCornerRadius="@dimen/corner_control"
            app:cardElevation="0dp"
            app:strokeColor="@color/input_border"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_tagline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/auth_input_padding_start"
                android:paddingTop="@dimen/auth_input_padding_v"
                android:paddingEnd="@dimen/auth_input_padding_end"
                android:paddingBottom="@dimen/auth_input_padding_v">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/et_username"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Username"
                    android:inputType="text"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/auth_field_text" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Email Input -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_email"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/auth_field_height"
            android:layout_marginStart="@dimen/auth_side_margin"
            android:layout_marginEnd="@dimen/auth_side_margin"
            android:layout_marginTop="@dimen/auth_gap"
            app:cardBackgroundColor="@color/dark_surface"
            app:cardCornerRadius="@dimen/corner_control"
            app:cardElevation="0dp"
            app:strokeColor="@color/input_border"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_username">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/auth_input_padding_start"
                android:paddingTop="@dimen/auth_input_padding_v"
                android:paddingEnd="@dimen/auth_input_padding_end"
                android:paddingBottom="@dimen/auth_input_padding_v">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_email"
                    app:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/et_email"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Email"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/auth_field_text" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Password Input -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_password"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/auth_field_height"
            android:layout_marginStart="@dimen/auth_side_margin"
            android:layout_marginEnd="@dimen/auth_side_margin"
            android:layout_marginTop="@dimen/auth_gap"
            app:cardBackgroundColor="@color/dark_surface"
            app:cardCornerRadius="@dimen/corner_control"
            app:cardElevation="0dp"
            app:strokeColor="@color/input_border"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_email">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/auth_input_padding_start"
                android:paddingTop="@dimen/auth_input_padding_v"
                android:paddingEnd="@dimen/auth_input_padding_end"
                android:paddingBottom="@dimen/auth_input_padding_v">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/et_password"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/auth_field_text" />

                <ImageButton
                    android:id="@+id/btn_toggle_password"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/toggle_password_visibility"
                    android:src="@drawable/ic_visibility_off"
                    app:tint="@color/text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Password Requirements -->
        <TextView
            android:id="@+id/tv_password_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_side_margin"
            android:layout_marginEnd="@dimen/auth_side_margin"
            android:layout_marginTop="@dimen/auth_gap_small"
            android:text="Minimal 6 karakter"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_password" />

        <!-- Sign Up Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sign_up"
            android:layout_width="0dp"
            android:layout_height="@dimen/auth_button_height"
            android:layout_marginStart="@dimen/auth_side_margin"
            android:layout_marginEnd="@dimen/auth_side_margin"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/font_family_inter"
            android:letterSpacing="0"
            android:text="Daftar"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="@dimen/auth_button_text"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_blue"
            app:cornerRadius="@dimen/corner_control"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_password_hint" />

        <!-- Loading Indicator (Hidden by default) -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminateTint="@android:color/white"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/btn_sign_up"
            app:layout_constraintEnd_toStartOf="@id/tv_signup_status"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@id/btn_sign_up"
            app:layout_constraintTop_toTopOf="@id/btn_sign_up"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_signup_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Membuat akun..."
            android:textColor="@android:color/white"
            android:textSize="@dimen/auth_status_text"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/btn_sign_up"
            app:layout_constraintEnd_toEndOf="@id/btn_sign_up"
            app:layout_constraintStart_toEndOf="@id/progress_bar"
            app:layout_constraintTop_toTopOf="@id/btn_sign_up"
            tools:visibility="visible" />

        <!-- Login Link -->
        <LinearLayout
            android:id="@+id/layout_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_side_margin"
            android:layout_marginEnd="@dimen/auth_side_margin"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_sign_up">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_family_inter"
                android:text="Sudah punya akun? "
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/auth_link_text" />

            <TextView
                android:id="@+id/tv_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_family_inter"
                android:text="Login"
                android:textColor="@color/accent_blue"
                android:textSize="@dimen/auth_link_text"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>