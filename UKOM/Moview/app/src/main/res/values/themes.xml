<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme using Material Components -->
    <style name="Theme.Moview" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color: blend with the standard dark app background.
             Hero pages (login/register/schedule/detail) override this to
             transparent at runtime for their edge-to-edge images. -->
        <item name="android:statusBarColor">@color/dark_background</item>

        <!-- Global font — BOTH attributes required (different API levels). -->
        <item name="android:fontFamily">@font/font_family_inter</item>
        <item name="fontFamily">@font/font_family_inter</item>

        <!-- Widget-level overrides — only widgets that ignore theme fontFamily -->
        <item name="chipStyle">@style/Widget.App.Chip</item>
        <item name="snackbarStyle">@style/Widget.App.Snackbar</item>
        <item name="snackbarButtonStyle">@style/Widget.App.Snackbar.Button</item>
        <!-- Buttons resolve their label via a textAppearance, which overrides the
             theme fontFamily. Pin Inter on the theme-level button appearances AND
             route every MaterialButton / framework Button through App styles. -->
        <item name="textAppearanceButton">@style/TextAppearance.App.Button</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.LabelLarge</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="buttonStyle">@style/Widget.App.PlainButton</item>
    </style>

    <!-- Snackbar -->
    <style name="Widget.App.Snackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="android:fontFamily">@font/font_family_inter</item>
        <item name="fontFamily">@font/font_family_inter</item>
    </style>
    <style name="Widget.App.Snackbar.Button" parent="Widget.MaterialComponents.Button.TextButton.Snackbar">
        <item name="android:fontFamily">@font/font_family_inter</item>
        <item name="fontFamily">@font/font_family_inter</item>
    </style>

    <!-- Buttons — Inter via textAppearance (buttons ignore the theme fontFamily). -->
    <style name="TextAppearance.App.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/font_family_inter</item>
        <item name="fontFamily">@font/font_family_inter</item>
    </style>
    <style name="TextAppearance.App.Button.M3" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/font_family_inter</item>
        <item name="fontFamily">@font/font_family_inter</item>
    </style>
    <!-- Theme attr textAppearanceLabelLarge (M3 components resolve labels through it). -->
    <style name="TextAppearance.App.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/font_family_inter</item>
        <item name="fontFamily">@font/font_family_inter</item>
    </style>

    <!-- Wired via materialButtonStyle so bare MaterialButtons get Inter. -->
    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/font_family_inter</item>
        <item name="fontFamily">@font/font_family_inter</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
    </style>
    <style name="Widget.App.Button.TextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:fontFamily">@font/font_family_inter</item>
        <item name="fontFamily">@font/font_family_inter</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
    </style>
    <style name="Widget.App.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:fontFamily">@font/font_family_inter</item>
        <item name="fontFamily">@font/font_family_inter</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
    </style>
    <style name="Widget.App.Button.Outlined.M3" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/font_family_inter</item>
        <item name="fontFamily">@font/font_family_inter</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button.M3</item>
    </style>
    <!-- Framework <Button> — wired via the theme's buttonStyle.
         textAppearance pinned too: Widget.AppCompat.Button's inherited
         TextAppearance.Widget.AppCompat.Button would otherwise win over
         the plain android:fontFamily item. -->
    <style name="Widget.App.PlainButton" parent="Widget.AppCompat.Button">
        <item name="android:fontFamily">@font/font_family_inter</item>
        <item name="fontFamily">@font/font_family_inter</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
    </style>

    <!-- Chip text appearance — Chip renders its label via android:textAppearance, not the
         Chip view's android:fontFamily. The phone's default font was showing because
         Chip was using the stock TextAppearance.MaterialComponents.Chip (Roboto). -->
    <style name="TextAppearance.App.Chip" parent="TextAppearance.MaterialComponents.Chip">
        <item name="android:fontFamily">@font/font_family_inter</item>
        <item name="fontFamily">@font/font_family_inter</item>
    </style>

    <!-- Chip — centralized chooser so no Chip uses the raw M2 default.
         App code should use Widget.App.Chip.* ; chipStyle guarantees the
         bare <Chip> (no style attr) also gets Inter. -->
    <style name="Widget.App.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:fontFamily">@font/font_family_inter</item>
        <item name="fontFamily">@font/font_family_inter</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Chip</item>
    </style>
    <style name="Widget.App.Chip.Choice" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:fontFamily">@font/font_family_inter</item>
        <item name="fontFamily">@font/font_family_inter</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Chip</item>
    </style>
    <style name="Widget.App.Chip.Action" parent="Widget.MaterialComponents.Chip.Action">
        <item name="android:fontFamily">@font/font_family_inter</item>
        <item name="fontFamily">@font/font_family_inter</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Chip</item>
    </style>
    <style name="Widget.App.Chip.Filter" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="android:fontFamily">@font/font_family_inter</item>
        <item name="fontFamily">@font/font_family_inter</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Chip</item>
    </style>

    <!-- Theme without action bar for main activity -->
    <style name="Theme.Moview.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Circle Image View for avatars -->
    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Rounded Corner 8dp for service logos -->
    <style name="RoundedCorner8dp">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!-- Rounded Corner 3dp for country flags -->
    <style name="RoundedCorner3dp">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">3dp</item>
    </style>

    <!-- Bottom Sheet Dialog Theme -->
    <style name="BottomSheetDialogTheme" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/ModalBottomSheetStyle</item>
    </style>

    <style name="ModalBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Tab Text Style for Crew Detail — add Inter while keeping color from TabLayout attrs -->
    <style name="TabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:fontFamily">@font/font_family_inter</item>
        <item name="fontFamily">@font/font_family_inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- Collapsing Toolbar Title -->
    <style name="TextAppearance.Moview.Toolbar.Title" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/font_family_inter</item>
        <item name="fontFamily">@font/font_family_inter</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- UCrop (external activity keeps its light UI) — Inter on the toolbar
         Crop/Cancel actions and any dialog buttons it shows. -->
    <style name="Theme.Moview.UCrop" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">@font/font_family_inter</item>
        <item name="fontFamily">@font/font_family_inter</item>
        <item name="textAppearanceButton">@style/TextAppearance.App.Button</item>
    </style>
</resources>
