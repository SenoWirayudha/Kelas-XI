<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft drop shadow (offset down-right) -->
    <item
        android:left="0dp"
        android:top="1dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="#66000000" />
        </shape>
    </item>
    <!-- Translucent scrim circle behind the back icon -->
    <item
        android:bottom="1dp">
        <shape android:shape="oval">
            <solid android:color="#59000000" />
        </shape>
    </item>
</layer-list>