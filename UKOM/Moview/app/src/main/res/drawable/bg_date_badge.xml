<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- tepi tumpukan halaman di bawah -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/date_badge_stack" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- badan kalender -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/date_badge_body" />
            <stroke
                android:width="1dp"
                android:color="@color/date_badge_stroke" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
